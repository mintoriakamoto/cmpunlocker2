+NV_STATUS
+kgspSec2PostblTimingStageBooterLoad
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp
+)
+{
+    SEC2_POSTBL_TIMING_REG_WRITE
+        writes[SEC2_POSTBL_TIMING_MULTIWRITE_MAX_WRITES];
+    GspFwWprMeta resumeMeta;
+    NvU32 handoffTokenBefore;
+    NvU32 writeCount = SEC2_POSTBL_TIMING_CORE_WRITE_COUNT;
+    NvU32 protectedWriteCount;
+    NvU64 booterFbSize;
+    NV_STATUS status;
+
+    if (!_kgspSec2PostblTimingEnabled(pGpu))
+        return NV_OK;
+
+    if ((pKernelGsp->pWprMeta == NULL) ||
+        (pKernelGsp->pWprMetaDescriptor == NULL) ||
+        (pKernelGsp->pWprMeta->sizeOfSignature ==
+         SEC2_POSTBL_TIMING_OVERFLOW_COPY_SIZE))
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    status = _kgspSec2PostblTimingInitCoreWrites(
+        pGpu, writes, NV_ARRAY_ELEMENTS(writes));
+    if (status != NV_OK)
+        return status;
+
+    handoffTokenBefore =
+        GPU_REG_RD32(pGpu, SEC2_POSTBL_TIMING_HANDOFF_TOKEN_ADDR);
+    if ((handoffTokenBefore == 0xffffffffU) ||
+        ((handoffTokenBefore & 0xffff0000U) == 0xbadf0000U))
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    /*
+     * Clear the Booter's pre-image-start gate in the same Heavy-Secure writer
+     * chain.  The signed continuation commits 0x11000000 only after GSP-RM
+     * has started.
+     */
+    writes[writeCount].addr = SEC2_POSTBL_TIMING_HANDOFF_TOKEN_ADDR;
+    writes[writeCount++].value =
+        handoffTokenBefore &
+        ~SEC2_POSTBL_TIMING_HANDOFF_PREBOOT_MASK;
+    protectedWriteCount = writeCount;
+
+    /*
+     * All variable-length writer frames must finish before signed GSP startup.
+     * Pad the nine real writes with harmless marker clears; slot 88 is the one
+     * non-zero completion marker.
+     */
+    while ((writeCount + 1U) <
+           SEC2_POSTBL_TIMING_MULTIWRITE_MAX_WRITES)
+    {
+        writes[writeCount].addr =
+            SEC2_POSTBL_TIMING_MULTIWRITE_MARKER_ADDR;
+        writes[writeCount++].value = 0U;
+    }
+
+    writes[writeCount].addr =
+        SEC2_POSTBL_TIMING_MULTIWRITE_MARKER_ADDR;
+    writes[writeCount++].value =
+        SEC2_POSTBL_TIMING_MULTIWRITE_MARKER_VALUE;
+    NV_ASSERT_OR_RETURN(
+        writeCount == SEC2_POSTBL_TIMING_MULTIWRITE_MAX_WRITES,
+        NV_ERR_INVALID_STATE);
+
+    status = _kgspSec2PostblTimingBuildResumeMeta(
+        pGpu, pKernelGsp, &resumeMeta);
+    if (status != NV_OK)
+        return status;
+
+    booterFbSize = pKernelGsp->pWprMeta->fbSize;
+    status = _kgspSec2PostblTimingRefillMultiwritePayload(
+        pGpu, pKernelGsp, writes, writeCount,
+        booterFbSize, &resumeMeta);
+    if (status != NV_OK)
+        return status;
+
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: same-Booter payload staged for the original "
+              "stock Booter (%u protected writes, %u fixed pre-handoff "
+              "slots)\n",
+              protectedWriteCount,
+              SEC2_POSTBL_TIMING_MULTIWRITE_MAX_WRITES);
+
+    return NV_OK;
+}
+
+NV_STATUS
+kgspSec2PostblTimingCompleteBooterLoad
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp
+)
+{
+    SEC2_POSTBL_TIMING_REG_WRITE writes[
+        SEC2_POSTBL_TIMING_CORE_WRITE_COUNT];
+    NvU64 bootFbSize;
+    NvU64 targetFbSize;
+    NvU32 handoffToken;
+    NvU32 marker;
+    NvU32 i;
+    NV_STATUS status;
+
+    if (!_kgspSec2PostblTimingEnabled(pGpu))
+        return NV_OK;
+
+    if ((pKernelGsp->pWprMeta == NULL) ||
+        (pKernelGsp->pWprMetaDescriptor == NULL) ||
+        (pKernelGsp->pWprMeta->sizeOfSignature !=
+         SEC2_POSTBL_TIMING_OVERFLOW_COPY_SIZE) ||
+        (pKernelGsp->pStockSignatureData == NULL) ||
+        (pKernelGsp->stockSignatureSize == 0ULL) ||
+        (pKernelGsp->stockSignatureSize >
+         SEC2_POSTBL_TIMING_STOCK_SIGNATURE_LIMIT))
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    marker = GPU_REG_RD32(
+        pGpu, SEC2_POSTBL_TIMING_MULTIWRITE_MARKER_ADDR);
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: original stock Booter returned; marker=0x%08x "
+              "expected=0x%08x\n",
+              marker, SEC2_POSTBL_TIMING_MULTIWRITE_MARKER_VALUE);
+    if (marker != SEC2_POSTBL_TIMING_MULTIWRITE_MARKER_VALUE)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: same-Booter chain did not reach its marker\n");
+        return NV_ERR_INVALID_STATE;
+    }
+
+    status = _kgspSec2PostblTimingInitCoreWrites(
+        pGpu, writes, NV_ARRAY_ELEMENTS(writes));
+    if (status != NV_OK)
+        return status;
+
+    for (i = 0; i < NV_ARRAY_ELEMENTS(writes); i++)
+    {
+        NvU32 readback = GPU_REG_RD32(pGpu, writes[i].addr);
+        if (readback != writes[i].value)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "SEC2_DEBUG: same-Booter verify[%u] addr=0x%08x "
+                      "want=0x%08x got=0x%08x\n",
+                      i, writes[i].addr, writes[i].value, readback);
+            return NV_ERR_INVALID_STATE;
+        }
+    }
+
+    handoffToken =
+        GPU_REG_RD32(pGpu, SEC2_POSTBL_TIMING_HANDOFF_TOKEN_ADDR);
+    if (handoffToken != SEC2_POSTBL_TIMING_HANDOFF_TOKEN_VALUE)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "SEC2_DEBUG: same-Booter handoff token mismatch: "
+                  "got=0x%08x expected=0x%08x\n",
+                  handoffToken,
+                  SEC2_POSTBL_TIMING_HANDOFF_TOKEN_VALUE);
+        return NV_ERR_INVALID_STATE;
+    }
+
+    status = _kgspSec2PostblTimingGetTargetFbSize(pGpu, &targetFbSize);
+    if (status != NV_OK)
+        return status;
+
+    bootFbSize = pKernelGsp->pWprMeta->fbSize;
+    pKernelGsp->pWprMeta->sizeOfSignature =
+        pKernelGsp->stockSignatureSize;
+    pKernelGsp->pWprMeta->fbSize = targetFbSize;
+    memdescFlushCpuCaches(pGpu, pKernelGsp->pWprMetaDescriptor);
+
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: same original stock Booter completed the signed "
+              "GSP handoff; bootFb=0x%016llx targetFb=0x%016llx\n",
+              bootFbSize, targetFbSize);
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: one-run PLM/compute/memory verify "
+              "WPR_CFG=0x%08x FBPA=0x%08x WPR=0x%08x FEAT=0x%08x "
+              "SS0=0x%08x SS1=0x%08x CFG1=0x%08x LMR=0x%08x "
+              "(devId=0x%x)\n",
+              GPU_REG_RD32(pGpu, 0x001fa7ccU),
+              GPU_REG_RD32(pGpu, 0x009a0148U),
+              GPU_REG_RD32(pGpu, 0x001fa7c4U),
+              GPU_REG_RD32(pGpu, 0x00823804U),
+              GPU_REG_RD32(pGpu, 0x0082381cU),
+              GPU_REG_RD32(pGpu, 0x00823820U),
+              GPU_REG_RD32(pGpu, 0x009a0204U),
+              GPU_REG_RD32(pGpu, 0x00100ce0U),
+              pGpu->idInfo.PCIDeviceID >> 16);
+
+    return NV_OK;
+}
