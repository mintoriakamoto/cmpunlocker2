+{
+    NvU32 devId = pGpu->idInfo.PCIDeviceID >> 16;
+
+    NV_ASSERT_OR_RETURN(pTargetFbBytes != NULL, NV_ERR_INVALID_ARGUMENT);
+
+    if (devId == SEC2_POSTBL_TIMING_CMP_170HX_8GB_PCI_DEVICE_ID)
+        *pTargetFbBytes = 0x0000001000000000ULL;
+    else if (devId == SEC2_POSTBL_TIMING_CMP_170HX_10GB_PCI_DEVICE_ID)
+        *pTargetFbBytes = 0x0000000a00000000ULL;
