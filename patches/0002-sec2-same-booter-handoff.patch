+static NV_STATUS
+_kgspSec2PostblTimingBuildResumeMeta
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp,
+    GspFwWprMeta *pResumeMeta
+)
+{
+    NvU64 targetFbBytes;
+    NvU64 oldFbBytes;
+    NV_STATUS status;
+
+    if ((pKernelGsp->pWprMeta == NULL) || (pResumeMeta == NULL) ||
+        (pKernelGsp->pStockSignatureData == NULL) ||
+        (pKernelGsp->stockSignatureSize == 0ULL) ||
+        (pKernelGsp->stockSignatureSize >
+         SEC2_POSTBL_TIMING_STOCK_SIGNATURE_LIMIT))
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    status = _kgspSec2PostblTimingGetTargetFbSize(pGpu, &targetFbBytes);
+    if (status != NV_OK)
+        return status;
+
+    *pResumeMeta = *pKernelGsp->pWprMeta;
+    oldFbBytes = pResumeMeta->fbSize;
+    if ((oldFbBytes == 0ULL) || (oldFbBytes > targetFbBytes))
+        return NV_ERR_INVALID_STATE;
+
+    /*
+     * The original Booter has already selected and populated the reachable
+     * low WPR before the overflowing signature DMA.  Preserve every WPR/image
+     * offset.  The runtime DMEM repair below also preserves oldFbBytes until
+     * the Booter's target-token handoff is complete; only the host descriptor
+     * published after success advertises the newly unlocked FB size.
+     */
+    pResumeMeta->sizeOfSignature = pKernelGsp->stockSignatureSize;
+    pResumeMeta->fbSize = targetFbBytes;
+
+    NV_PRINTF(LEVEL_ERROR,
+              "SEC2_DEBUG: same-Booter resume meta bootFb=0x%016llx "
+              "targetFb=0x%016llx preservedWprStart=0x%016llx "
+              "heap=0x%016llx boot=0x%016llx fw=0x%016llx sig=%llu\n",
+              oldFbBytes,
+              pResumeMeta->fbSize,
+              pResumeMeta->gspFwWprStart,
+              pResumeMeta->gspFwHeapSize,
+              pResumeMeta->bootBinOffset,
+              pResumeMeta->gspFwOffset,
+              pResumeMeta->sizeOfSignature);
+
+    return NV_OK;
+}
