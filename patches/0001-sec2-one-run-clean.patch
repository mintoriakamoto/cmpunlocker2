+/*
+ * Build one Heavy-Secure SEC2 execution containing writeCount protected PRI
+ * writes.  The first writer returns through the valid FUC5 instruction at
+ * IMEM 0x7934:
+ *
+ *     mpopaddret r0, -0x1344
+ *
+ * With entry SP 0xff90, the signed adjustment relocates execution to the
+ * chain at DMEM 0xec50.  Each subsequent 0x30-byte cycle invokes:
+ *
+ *     0x0cbd -> 0x1fbd -> 0x10aa
+ */
+static NV_STATUS
+_kgspSec2PostblTimingFillMultiwritePayload
+(
+    NvU8 *pSignatureVa,
+    NvU64 signatureSize,
+    const SEC2_POSTBL_TIMING_REG_WRITE *pWrites,
+    NvU32 writeCount
+)
+{
+    const NvU32 canary = 0xc0deca7eU;
+    const NvU32 pivotRet = 0x0000ec50U;
+    NvU32 stack;
+    NvU32 tail;
+    NvU32 i;
+
+    if ((signatureSize < SEC2_POSTBL_TIMING_SIGNATURE_SIZE) ||
+        (pWrites == NULL) || (writeCount == 0U))
+    {
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    if (writeCount > SEC2_POSTBL_TIMING_MULTIWRITE_MAX_WRITES)
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+
+    for (i = 0; i + sizeof(NvU32) <= signatureSize; i += sizeof(NvU32))
+    {
+        _kgspSec2PostblTimingPutU32(
+            pSignatureVa, i, SEC2_POSTBL_TIMING_FILL_DWORD);
+    }
+
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0x1100U, 0x00000007U);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0x5b40U, canary);
+
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf744U, 0x00000000U);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf754U, 0x5331c0deU);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf758U, canary);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf75cU, 0x00000cbdU);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf76cU, 0x000014fcU);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf774U, 0x00001fbdU);
+    _kgspSec2PostblTimingPutU32(
+        pSignatureVa, 0xf780U, pWrites[0].value);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf788U, 0x000010aaU);
+    _kgspSec2PostblTimingPutU32(pSignatureVa, 0xf78cU, 0x00007934U);
+    _kgspSec2PostblTimingPutU32(
+        pSignatureVa, 0xf790U, pWrites[0].value);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, pivotRet - 0x04U, pWrites[0].value);
+
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, pivotRet, 0x00000cbdU);
+    stack = pivotRet + 0x04U;
+
+    for (i = 0; i < writeCount; i++)
+    {
+        _kgspSec2PostblTimingPutDmemU32(
+            pSignatureVa, stack + 0x0cU, pWrites[i].addr);
+        _kgspSec2PostblTimingPutDmemU32(
+            pSignatureVa, stack + 0x14U, 0x00001fbdU);
+        _kgspSec2PostblTimingPutDmemU32(
+            pSignatureVa, stack + 0x20U,
+            (i + 1U < writeCount) ? pWrites[i + 1U].value : 0U);
+        _kgspSec2PostblTimingPutDmemU32(
+            pSignatureVa, stack + 0x28U, 0x000010aaU);
+        _kgspSec2PostblTimingPutDmemU32(
+            pSignatureVa, stack + 0x2cU,
+            (i + 1U < writeCount) ? 0x00000cbdU : 0x0000815aU);
+        stack += 0x30U;
+    }
+
+    tail = stack;
+    NV_ASSERT_OR_RETURN((tail + 0x6cU) <= 0x00010000U,
+                        NV_ERR_INSUFFICIENT_RESOURCES);
+
+    /*
+     * Relocated copy of the proven one-write cleanup frame.  Returning here
+     * leaves SEC2 resettable for the following stock Booter invocation.
+     */
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x00U, 0x00008e18U);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x04U, canary);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x08U, 0x0000815aU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x0cU, 0x00000000U);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x10U, canary);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x14U, 0x00001fbdU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x20U, tail + 0x2cU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x28U, 0x0000582dU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x34U, canary);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x38U, 0x00000cbdU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x48U, 0x00000003U);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x50U, 0x00001fbdU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x64U, 0x00000ccbU);
+    _kgspSec2PostblTimingPutDmemU32(
+        pSignatureVa, tail + 0x68U, 0x00007f2fU);
+
+    return NV_OK;
+}
