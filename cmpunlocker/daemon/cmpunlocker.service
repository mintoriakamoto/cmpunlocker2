[Unit]
Description=NVIDIA CMP 170HX Unlock Daemon
Documentation=man:cmpunlocker(1)
After=network.target nvidia-driver.service gen2.service
ConditionPathExists=/dev/mem
ConditionPathExists=/sys/bus/pci/

[Service]
Type=simple
# /opt/cmpunlocker must be on PYTHONPATH for the `cmpunlocker.*` absolute
# imports used throughout the package to resolve when run as a bare script.
Environment=PYTHONPATH=/opt/cmpunlocker
ExecStart=/usr/bin/python3 /opt/cmpunlocker/cmpunlocker/daemon/watchdog.py
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cmpunlocker
User=root
# Prevent daemon from blocking shutdown
KillMode=process
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
